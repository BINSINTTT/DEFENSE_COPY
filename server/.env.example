VALIDATION_API_PORT=8765
# Disease classification model
ULTRALYTICS_PREDICT_URL=https://your-classification-url.run.app/predict
ULTRALYTICS_API_KEY=your_ultralytics_api_key
# Severity is measured locally by OpenCV; no severity endpoint or key is needed.
# Early Blight vs Spotted Wilt specialist segmentation model. It reuses
# ULTRALYTICS_API_KEY unless a separate specialist key is provided.
ULTRALYTICS_SPECIALIST_URL=https://predict-6afa58f182bb456194fcba6e-dproatj77a-dt.a.run.app/predict
# ULTRALYTICS_SPECIALIST_API_KEY=your_specialist_endpoint_api_key
ULTRALYTICS_SPECIALIST_CONF=0.25
ULTRALYTICS_SPECIALIST_IOU=0.5
ULTRALYTICS_SPECIALIST_IMGSZ=640
ULTRALYTICS_SPECIALIST_WEIGHT=0.65
ULTRALYTICS_SPECIALIST_MIN_CONFIDENCE=0.5
ULTRALYTICS_SPECIALIST_MIN_MARGIN=0.1
# Image validation model (leaf check). /predict is added if you omit it.
ULTRALYTICS_VALIDATION_URL=https://predict-6ae37ce0bbd46ce898ad6e66-dproatj77a-df.a.run.app/predict

# Groq — AI care recommendations (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
# Optional; see https://console.groq.com/docs/models
# Run: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b
